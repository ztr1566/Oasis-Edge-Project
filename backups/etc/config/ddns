
config ddns 'global'
	option date_format '%F %R'
	option log_lines '250'
	option ddns_dateformat '%F %R'
	option ddns_rundir '/var/run/ddns'
	option ddns_logdir '/var/log/ddns'
	option ddns_loglines '250'

config service 'myddns_ipv4'
	option enabled '1'
	option service_name 'duckdns.org'
	option ip_source 'interface'
	option lookup_host 'ztrdns.duckdns.org'
	option use_ipv6 '0'
	option check_interval '5'
	option check_unit 'minutes'
	option force_interval '24'
	option force_unit 'hours'
	option domain 'ztrdns'
	option username 'dummy'
	option password '5cb66c5d-658a-4e23-814d-eae815885d36'
	option ip_interface 'pppoe-WAN'
	option use_syslog '2'
	option interface 'WAN'
	option dns_server '1.1.1.1'

